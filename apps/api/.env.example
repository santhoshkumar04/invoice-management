NODE_ENV=development

PORT=4000
HOST=0.0.0.0

APP_NAME=Invoice Management API

CORS_ORIGIN=http://localhost:8081

DATABASE_URL=postgresql://invoice_app:Computer%4004@localhost:5432/invoice_management

# Authentication
JWT_ACCESS_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ACCESS_EXPIRES_IN=15m

REFRESH_TOKEN_EXPIRES_DAYS=30

JWT_ISSUER=invoice-management-api
JWT_AUDIENCE=invoice-management-mobile

# Initial organization and admin
ORGANIZATION_NAME=Your Business Name

ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_UNIQUE_PASSWORD

# Private invoice document storage
INVOICE_DOCUMENT_STORAGE_DIR=./storage/invoice-documents